{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["helpers/**/*.ts","tests/**/*.ts", "playwright.config.ts", "types/**/*.ts", "pages/**/*.ts", "fixtures/**/*.ts", "orders/**/*.ts", "scripts/**/*.ts", "data/**/*.ts"]
}
