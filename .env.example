# Copy to .env and fill in the passwords. .env is gitignored and never committed.
# The practice users and their passwords are listed in practice-app-v2/README.md.

# Where Practice-App-v2 is running (npm run start --prefix practice-app-v2).
BASE_URL=http://localhost:3300

TRADER1_USERNAME=trader1
TRADER1_PASSWORD=
TRADER2_USERNAME=trader2
TRADER2_PASSWORD=
APPROVER1_USERNAME=approver1
APPROVER1_PASSWORD=

# Optional: run the isolated per-test apps from another copy of practice-app-v2
# (for example a deliberately broken one, to prove a test can fail).
# APP_DIR=
